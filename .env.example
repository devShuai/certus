CERTUS_ADDR=:8080
CERTUS_ISSUER=http://localhost:8080
CERTUS_ENV=development
CERTUS_SHUTDOWN_TIMEOUT=10s
# 仅配置实际反向代理的 IP/CIDR；未配置时忽略 X-Forwarded-For。
CERTUS_TRUSTED_PROXIES=
# 留空时使用内存仓储，设置后启用 PostgreSQL 并自动迁移。
CERTUS_DATABASE_URL=
# 管理 API 的 Bearer Token；留空时管理 API 保持关闭。
CERTUS_ADMIN_TOKEN=
# Prometheus 指标专用 Bearer Token（至少 32 字符）；留空时 /metrics 不注册。
CERTUS_METRICS_TOKEN=
# 32 字节随机主密钥的 Base64 编码；配置后允许用户启用 TOTP MFA。
CERTUS_MFA_ENCRYPTION_KEY=
# OIDC 私钥、TOTP 和动态身份源凭据共用的封装密钥环，格式为
# key-id=Base64-32字节密钥；首项是当前主密钥，轮换时暂时保留历史密钥。
# 生产 PostgreSQL 模式必须配置。
CERTUS_SECRET_ENCRYPTION_KEYS=
# 设为 0 可关闭定时清理；审计与退役签名密钥分别默认保留 90 天和 24 小时。
CERTUS_CLEANUP_INTERVAL=15m
CERTUS_AUDIT_RETENTION=2160h
CERTUS_SIGNING_KEY_RETENTION=24h
# 设为 0 可关闭自动轮换，非零值不得少于 1 小时。
CERTUS_SIGNING_KEY_ROTATION_INTERVAL=24h
# 认证限流；对应 limit 设为 0 可单独关闭。PostgreSQL 模式下多实例共享计数。
CERTUS_LOGIN_SOURCE_RATE_LIMIT=30
CERTUS_LOGIN_SOURCE_RATE_WINDOW=1m
CERTUS_LOGIN_IDENTITY_RATE_LIMIT=10
CERTUS_LOGIN_IDENTITY_RATE_WINDOW=5m
CERTUS_MFA_RATE_LIMIT=10
CERTUS_MFA_RATE_WINDOW=5m
CERTUS_OAUTH_RATE_LIMIT=600
CERTUS_OAUTH_RATE_WINDOW=1m
CERTUS_DEVICE_RATE_LIMIT=20
CERTUS_DEVICE_RATE_WINDOW=1m
